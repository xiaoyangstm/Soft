<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@mipmap/shiyanshi_back">


    <RelativeLayout
        android:id="@+id/first_ellipse_area"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"

        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.025"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:layout_width="369dp"
            android:layout_height="90dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/time_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="13:30"
                    android:textColor="#FFFFFF"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/date_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2025年6月12日 周四"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4sp">

                <TextView
                    android:id="@+id/salt_value_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/yanfen_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4sp">

                <TextView
                    android:id="@+id/dan_value_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dan_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4sp">

                <TextView
                    android:id="@+id/lin_value_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lin_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"

                android:padding="4sp">

                <TextView
                    android:id="@+id/jia_value_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/jia_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>


        </LinearLayout>

    </RelativeLayout>

    <TextView
        android:id="@+id/textView7"
        android:layout_width="51dp"
        android:layout_height="33dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="196dp"
        android:text="温度"

        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView13"
        android:layout_width="49dp"
        android:layout_height="34dp"
        android:layout_marginStart="208dp"
        android:layout_marginTop="196dp"
        android:text="光照"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="50dp"
        android:layout_height="29dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:text="湿度"
        android:textColor="#000000"
        android:textSize="20sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView7" />

    <TextView
        android:id="@+id/textView15"
        android:layout_width="52dp"
        android:layout_height="31dp"
        android:layout_marginStart="196dp"
        android:layout_marginTop="20dp"
        android:text="火焰"
        android:textColor="#000000"
        android:textSize="20sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView7" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="52dp"
        android:layout_height="30dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:text="烟雾"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView8" />


    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="369dp"
        android:layout_height="212dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="48dp"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="9dp"
            android:text="请输入温度和湿度的阈值:"

            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 温度下限输入框 -->
            <EditText
                android:id="@+id/temperature_low"
                android:layout_width="150dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:hint="输入温度下限值"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#000000"
                android:textSize="15dp" />

            <!-- 温度上限输入框 -->
            <EditText
                android:id="@+id/temperature_high"
                android:layout_width="150dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:hint="输入温度上限值"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#000000"
                android:textSize="15dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 湿度下限输入框 -->
            <EditText
                android:id="@+id/humidity_low"
                android:layout_width="150dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:hint="输入湿度下限值"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#000000"
                android:textSize="15dp" />

            <!-- 湿度上限输入框 -->

            <!-- 确定按钮 -->
            <EditText
                android:id="@+id/humidity_high"
                android:layout_width="150dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:hint="输入湿度上限值"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#000000"
                android:textSize="15dp" />

            <Button
                android:id="@+id/confirm_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@color/transparent"
                android:text="确定"
                android:textColor="#000000"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>


    <TextView
        android:id="@+id/temperature_text"
        android:layout_width="61dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="80dp"
        android:text=""
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/textView7"
        app:layout_constraintTop_toBottomOf="@+id/first_ellipse_area" />

    <TextView
        android:id="@+id/light_text"
        android:layout_width="71dp"
        android:layout_height="33dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="80dp"
        android:text=""
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.209"
        app:layout_constraintStart_toEndOf="@+id/textView13"
        app:layout_constraintTop_toBottomOf="@+id/first_ellipse_area" />

    <TextView
        android:id="@+id/humidity_text"
        android:layout_width="57dp"
        android:layout_height="36dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:text=""
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/textView8"
        app:layout_constraintTop_toBottomOf="@+id/temperature_text" />


    <TextView
        android:id="@+id/fire_text"
        android:layout_width="70dp"
        android:layout_height="35dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:text=""
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.36"
        app:layout_constraintStart_toEndOf="@+id/textView15"
        app:layout_constraintTop_toBottomOf="@+id/light_text" />

    <TextView
        android:id="@+id/smoke_text"
        android:layout_width="65dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:text=""
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/textView9"
        app:layout_constraintTop_toBottomOf="@+id/humidity_text" />

    <Button
        android:id="@+id/light_on_button"
        android:layout_width="78dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/circle"
        android:textColor="#000000"
        android:text="打开灯光"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView9" />

    <Button
        android:id="@+id/light_off_button"
        android:layout_width="82dp"
        android:layout_height="35dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/circle"
        android:text="关闭灯光"
        android:textColor="#000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/light_on_button" />

    <Button
        android:id="@+id/ventilate_on_button"
        android:layout_width="78dp"
        android:layout_height="35dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/circle"
        android:text="打开通风"
        android:textColor="#000000"
        app:layout_constraintStart_toEndOf="@+id/light_on_button"
        app:layout_constraintTop_toBottomOf="@+id/smoke_text" />

    <Button
        android:id="@+id/ventilate_off_button"
        android:layout_width="74dp"
        android:layout_height="33dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/circle"
        android:text="关闭通风"
        android:textColor="#000000"
        app:layout_constraintStart_toEndOf="@+id/light_off_button"
        app:layout_constraintTop_toBottomOf="@+id/ventilate_on_button" />

    <Button
        android:id="@+id/air_on_button"
        android:layout_width="81dp"
        android:layout_height="37dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="76dp"

        android:background="@drawable/circle"
        android:text="打开空调"
        android:textColor="#000000"
        app:layout_constraintStart_toEndOf="@+id/ventilate_on_button"
        app:layout_constraintTop_toBottomOf="@+id/textView15" />

    <Button
        android:id="@+id/air_off_button"
        android:layout_width="85dp"
        android:layout_height="37dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/circle"
        android:text="关闭空调"
        android:textColor="#000000"
        app:layout_constraintStart_toEndOf="@+id/ventilate_off_button"
        app:layout_constraintTop_toBottomOf="@+id/air_on_button" />

    <Button
        android:id="@+id/curtain_on_button"
        android:layout_width="77dp"
        android:layout_height="35dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/circle"
        android:text="打开窗帘"
        android:textColor="#000000"
        app:layout_constraintStart_toEndOf="@+id/air_on_button"
        app:layout_constraintTop_toBottomOf="@+id/fire_text" />

    <Button
        android:id="@+id/curtaion_off_button"
        android:layout_width="76dp"
        android:layout_height="37dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/circle"
        android:text="关闭窗帘"
        android:textColor="#000000"
        app:layout_constraintStart_toEndOf="@+id/air_off_button"
        app:layout_constraintTop_toBottomOf="@+id/curtain_on_button" />


</androidx.constraintlayout.widget.ConstraintLayout>